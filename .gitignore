# Logs: contienen TODO lo dictado y las respuestas completas de opencode.
# No versionar (privacidad).
*.log
*.log.*

# Temporales del runner y cache de voz (se regeneran solos)
tmp/
prompt-*.txt
output-*.txt

# Modelos de voz: binarios grandes y descargables. No versionar.
#   Piper (97 MB):  https://github.com/rhasspy/piper/releases
#   Vosk  (38 MB):  https://alphacephei.com/vosk/models/vosk-model-small-es-0.42.zip
piper/
vosk/

# Obsidian guarda aqui su configuracion de espacio de trabajo
memoria/.obsidian/workspace.json
memoria/.obsidian/workspace-mobile.json

# NOTAS PERSONALES: el repositorio es PUBLICO. Lo que dictas con "recuerda
# que..." y las estadisticas de uso no salen de esta maquina. Solo se
# versiona el README del vault.
memoria/diario/
memoria/temas/
memoria/estadisticas.json
memoria/estadisticas.md
memoria/fechas.json
memoria/recordatorios.json
memoria/rechazos.json

# tu voz: las grabaciones para medir el reconocimiento se quedan en casa
pruebas/audio/
# ordenes aprendidas: son frases dictadas por el usuario
traducciones.json
memoria/semanas/
reglas.json
# tus listas (la compra, pendientes...) y las copias de seguridad de todo lo
# anterior: lo mismo, no salen de esta maquina
memoria/listas.json
copias/
# las conversaciones con el cerebro (modo charla): lo que se habla, en casa
cerebro/

# Residuos de diagnostico
probe-*.txt
run-out.txt
run-err.txt
live.*
mutex.txt

# Python
__pycache__/
*.pyc
# las tareas aprendidas (llevan rutas y nombres tuyos)
memoria/recetas.json
# lo que Nova sabe de ti (carpetas, juegos, preferencias)
memoria/perfil.md
# lo que recuerda de cada juego: donde te quedaste y cuanto gasta de bateria
memoria/juegos.json
# tus costumbres (que ordenes das y a que hora), para proponerte automatizarlas
memoria/habitos.json
# tus contactos importantes (nombres de personas)
memoria/contactos.json
# tus notas de voz (tu voz y lo que dices)
memoria/notas-voz/
# el cerebro propio de Nova: todo lo que ha aprendido hablando contigo
memoria/cerebro/
# lo que has escuchado y cuando
memoria/musica.json
# lo que queda a medias si se va la luz justo al guardar (ver Write-Atomico)
*.json.tmp
# archivos de memoria que no se podian leer, apartados en vez de perderse
*.corrupto-*

# modelos de voz descargados (Parakeet...): pesan cientos de MB
modelos/
